@model UnsubscribePageViewModel
@{
    ViewData["Title"] = Localizer["Desligar as novidades"].Value;
}

<h1 class="break-words">@Localizer["Desligar as novidades de {0}", Model.MaskedEmail]</h1>

<div class="card max-w-xl" data-unsubscribe>
    <p>@Localizer["Você vai parar de receber os e-mails de kits novos e pré-vendas. Os e-mails dos seus pedidos continuam chegando normalmente."]</p>
    <form asp-controller="Newsletter" asp-action="ConfirmUnsubscribe" method="post">
        <input type="hidden" name="token" value="@Model.Token" />
        <button type="submit" class="btn btn-primary">@Localizer["Não quero mais receber"]</button>
    </form>
</div>
