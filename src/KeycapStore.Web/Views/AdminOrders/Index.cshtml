@using KeycapStore.Web.Models
@model IReadOnlyList<KeycapStore.Application.Orders.AdminOrderView>
@{
    ViewData["Title"] = Localizer["Envio de pedidos"].Value;
}

<h1>@Localizer["Envio de pedidos"]</h1>

@if (Model.Count == 0)
{
    <p>@Localizer["Nenhum pedido para separar, enviar, entregar ou receber de volta."]</p>
}
else
{
    <table class="table align-top">
        <thead>
            <tr>
                <th>@Localizer["Pedido"]</th>
                <th>@Localizer["Itens"]</th>
                <th class="text-end">@Localizer["Total"]</th>
                <th>@Localizer["Entrega"]</th>
                <th>@Localizer["Situação"]</th>
                <th>@Localizer["Ação"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                var address = order.ShippingAddress;
                <tr>
                    <td>
                        <code>@order.Id</code><br />
                        <small class="text-muted">@Display.DateAndTime(order.CreatedAt)</small>
                    </td>
                    <td>
                        @foreach (var line in order.Lines)
                        {
                            <div>@line.Quantity × @line.ProductName</div>
                        }
                    </td>
                    <td class="text-end">@Display.Price(order.Total)</td>
                    <td>
                        @address.RecipientName<br />
                        @address.Street, @address.Number@(address.Complement is null ? "" : $" - {address.Complement}")<br />
                        @address.District, @address.City - @address.State<br />
                        @Localizer["CEP {0}", address.PostalCode.Insert(5, "-")]
                    </td>
                    <td>
                        <strong>@SharedLocalizer[OrderStatusText.For(order.Status)]</strong>
                        @if (order.TrackingCode is not null)
                        {
                            <br /><small>@Localizer["Rastreio: {0}", order.TrackingCode]</small>
                        }
                    </td>
                    <td>
                        @if (order.Status == KeycapStore.Domain.Orders.OrderStatus.Paid)
                        {
                            <form asp-action="StartPicking" asp-route-id="@order.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-primary">@Localizer["Iniciar separação"]</button>
                            </form>
                        }
                        else if (order.Status == KeycapStore.Domain.Orders.OrderStatus.Picking)
                        {
                            <form asp-action="Ship" asp-route-id="@order.Id" method="post">
                                <input name="trackingCode" class="form-control form-control-sm mb-1" placeholder="@Localizer["Código de rastreio"]" maxlength="@KeycapStore.Domain.Orders.Order.MaxTrackingCodeLength" required />
                                <button type="submit" class="btn btn-sm btn-primary">@Localizer["Marcar como enviado"]</button>
                            </form>
                        }
                        else if (order.Status == KeycapStore.Domain.Orders.OrderStatus.Shipped)
                        {
                            <form asp-action="Deliver" asp-route-id="@order.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-success">@Localizer["Marcar como entregue"]</button>
                            </form>
                        }
                        else if (order.Status == KeycapStore.Domain.Orders.OrderStatus.Withdrawn)
                        {
                            <small class="text-muted">@Localizer["Cliente desistiu; aguardando o reembolso automático."]</small>
                        }
                        else if (order.Status == KeycapStore.Domain.Orders.OrderStatus.AwaitingReturn)
                        {
                            <form asp-action="ConfirmReturn" asp-route-id="@order.Id" method="post">
                                <div class="form-check mb-1">
                                    <input type="checkbox" name="restock" value="true" class="form-check-input" id="restock-@order.Id" />
                                    <label class="form-check-label" for="restock-@order.Id">@Localizer["Volta ao estoque"]</label>
                                </div>
                                <button type="submit" class="btn btn-sm btn-warning">@Localizer["Devolução recebida"]</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}