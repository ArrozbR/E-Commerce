@{
    ViewData["Title"] = Localizer["Link inválido"].Value;
}

<h1>@Localizer["Link inválido"]</h1>

<div class="card max-w-xl" data-reset-invalid>
    <p>@Localizer["Este link é inválido ou venceu. Os links valem por 30 minutos e só funcionam uma vez."]</p>
    <a asp-action="ForgotPassword" class="btn btn-primary">@Localizer["Pedir outro link"]</a>
</div>
