@model AddressViewModel
@{
    ViewData["Title"] = Localizer["Endereço salvo"].Value;
}

<h1>@Localizer["Endereço salvo"]</h1>
<p class="text-muted">@Localizer["Ele preenche o formulário do checkout nas próximas compras. Salvar aqui substitui o endereço salvo antes, e os pedidos já feitos não mudam."]</p>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Address" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <partial name="_AddressFields" model="Model" />

            <button type="submit" class="btn btn-primary">@Localizer["Salvar endereço"]</button>
            <a asp-action="Delete" class="btn btn-link">@Localizer["Voltar para Minha conta"]</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
