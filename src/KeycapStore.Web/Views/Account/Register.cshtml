@model RegisterViewModel
@{
    ViewData["Title"] = Localizer["Criar conta"].Value;
}

<h1>@Localizer["Criar conta"]</h1>

<div>
    <div class="max-w-md">
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Email" class="label"></label>
                <input asp-for="Email" class="input" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="label"></label>
                <input asp-for="Password" class="input" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="label"></label>
                <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="check mb-4">
                <input id="ReceiveNews" name="ReceiveNews" type="checkbox" value="true" class="check-input" checked="@Model?.ReceiveNews" />
                <label for="ReceiveNews" class="check-label">@Localizer["Quero receber e-mails de kits novos e pré-vendas"]</label>
            </div>

            <button type="submit" class="btn btn-primary">@Localizer["Criar conta"]</button>
        </form>
    </div>
</div>

<div class="mt-4">
    <div class="max-w-md">
        <form asp-action="ExternalLogin" method="post">
            <button type="submit" class="btn btn-secondary w-full">@Localizer["Criar conta com o Google"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}