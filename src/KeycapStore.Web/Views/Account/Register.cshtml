@model RegisterViewModel
@{
    ViewData["Title"] = Localizer["Criar conta"].Value;
}

<h1>@Localizer["Criar conta"]</h1>

<div class="row">
    <div class="col-md-5">
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">@Localizer["Criar conta"]</button>
        </form>
    </div>
</div>

<div class="row mt-3">
    <div class="col-md-5">
        <form asp-action="ExternalLogin" method="post">
            <button type="submit" class="btn btn-outline-dark w-100">@Localizer["Criar conta com o Google"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}