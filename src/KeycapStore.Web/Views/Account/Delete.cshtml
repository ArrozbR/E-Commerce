@model DeleteAccountViewModel
@{
    ViewData["Title"] = Localizer["Minha conta"].Value;
    var account = (KeycapStore.Application.Identity.AccountSummary)ViewData["Account"]!;
}

<h1>@Localizer["Minha conta"]</h1>
<p class="text-muted">@Localizer["Conectado como {0}", User.Identity?.Name ?? ""]</p>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<h2 class="h4 mt-4">@Localizer["Endereço salvo"]</h2>
@if (ViewData["SavedAddress"] is KeycapStore.Domain.Orders.ShippingAddress saved)
{
    <p>
        @saved.RecipientName<br />
        @saved.Street, @saved.Number@(saved.Complement is null ? "" : $" - {saved.Complement}")<br />
        @saved.District, @saved.City - @saved.State<br />
        @Localizer["CEP {0}", saved.PostalCode.Insert(5, "-")]
    </p>
    <p class="text-muted">@Localizer["Ele só preenche o formulário do checkout. Os pedidos já feitos guardam o próprio endereço e não mudam."]</p>
    <form asp-action="RemoveSavedAddress" method="post">
        <a asp-action="Address" class="btn btn-outline-primary">@Localizer["Alterar endereço"]</a>
        <button type="submit" class="btn btn-outline-secondary">@Localizer["Remover endereço salvo"]</button>
    </form>
}
else
{
    <p class="text-muted">@Localizer["Nenhum endereço salvo. Você pode cadastrar um agora ou marcar a caixa no checkout ao finalizar uma compra."]</p>
    <a asp-action="Address" class="btn btn-outline-primary">@Localizer["Cadastrar endereço"]</a>
}

<h2 class="h4 mt-4">@Localizer["Entrar com o Google"]</h2>
@if (account.IsAdmin)
{
    <p class="text-muted">@Localizer["Contas de administrador entram só com a senha."]</p>
}
else if (account.HasGoogle)
{
    <p>@Localizer["Sua conta está conectada ao Google."]</p>
}
else
{
    <p class="text-muted">@Localizer["Conecte a sua conta Google para entrar sem digitar a senha. O e-mail do Google precisa ser o mesmo desta conta."]</p>
    <form asp-action="LinkGoogle" method="post">
        <button type="submit" class="btn btn-outline-dark">@Localizer["Conectar o Google"]</button>
    </form>
}

<h2 class="h4 mt-4">@Localizer["Excluir minha conta"]</h2>
<div class="row">
    <div class="col-md-7">
        <p>
            @Localizer["Ao excluir a conta, o seu e-mail, a sua senha e o endereço salvo são apagados e você não consegue mais entrar."]
            @Localizer["Os pedidos já feitos continuam registrados, sem ligação com a conta, pelo prazo que a lei exige para registros de venda."]
        </p>
        <p>
            @Localizer["A exclusão só é possível quando todos os seus pedidos estiverem finalizados, inclusive o prazo de 7 dias para desistir depois da entrega."]
        </p>

        <form asp-action="Delete" method="post" onsubmit="return confirm('@Localizer["Excluir a conta? Esta ação não pode ser desfeita."]');">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                @if (account.HasPassword)
                {
                    <label for="Confirmation" class="form-label">@Localizer["Senha atual"]</label>
                    <input asp-for="Confirmation" type="password" class="form-control" autocomplete="current-password" />
                }
                else
                {
                    <label for="Confirmation" class="form-label">@Localizer["Para confirmar, digite o e-mail desta conta"]</label>
                    <input asp-for="Confirmation" type="email" class="form-control" autocomplete="off" />
                }
                <span asp-validation-for="Confirmation" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-danger">@Localizer["Excluir minha conta"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
