@model DeleteAccountViewModel
@{
    ViewData["Title"] = "Minha conta";
}

<h1>Minha conta</h1>
<p class="text-muted">Conectado como @User.Identity?.Name</p>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<h2 class="h4 mt-4">Endereço salvo</h2>
@if (ViewData["SavedAddress"] is KeycapStore.Domain.Orders.ShippingAddress saved)
{
    <p>
        @saved.RecipientName<br />
        @saved.Street, @saved.Number@(saved.Complement is null ? "" : $" - {saved.Complement}")<br />
        @saved.District, @saved.City - @saved.State<br />
        CEP @saved.PostalCode.Insert(5, "-")
    </p>
    <p class="text-muted">Ele só preenche o formulário do checkout. Os pedidos já feitos guardam o próprio endereço e não mudam.</p>
    <form asp-action="RemoveSavedAddress" method="post">
        <button type="submit" class="btn btn-outline-secondary">Remover endereço salvo</button>
    </form>
}
else
{
    <p class="text-muted">Nenhum endereço salvo. Para salvar, marque a caixa no checkout ao finalizar uma compra.</p>
}

<h2 class="h4 mt-4">Excluir minha conta</h2>
<div class="row">
    <div class="col-md-7">
        <p>
            Ao excluir a conta, o seu e-mail, a sua senha e o endereço salvo são apagados e você não consegue mais entrar.
            Os pedidos já feitos continuam registrados, sem ligação com a conta, pelo prazo que a lei exige para registros de venda.
        </p>
        <p>
            A exclusão só é possível quando todos os seus pedidos estiverem finalizados,
            inclusive o prazo de 7 dias para desistir depois da entrega.
        </p>

        <form asp-action="Delete" method="post" onsubmit="return confirm('Excluir a conta? Esta ação não pode ser desfeita.');">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-danger">Excluir minha conta</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
