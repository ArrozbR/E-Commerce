@using KeycapStore.Application.Identity
@model ChangePasswordViewModel
@{
    ViewData["Title"] = Localizer["Trocar a senha"].Value;
    var account = (AccountSummary)ViewData["Account"]!;
}

<h1>@Localizer["Trocar a senha"]</h1>

<div class="card max-w-xl">
    @if (!account.HasPassword)
    {
        <p>@Localizer["Esta conta entra pelo Google e não tem senha para trocar."]</p>
        <a asp-action="Delete" class="btn btn-secondary">@Localizer["Voltar para Minha conta"]</a>
    }
    else
    {
        <form asp-action="Password" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

            <div class="mb-4">
                <label asp-for="CurrentPassword" class="label"></label>
                <input asp-for="CurrentPassword" class="input" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="NewPassword" class="label"></label>
                <input asp-for="NewPassword" class="input" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmNewPassword" class="label"></label>
                <input asp-for="ConfirmNewPassword" class="input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
            </div>

            <p class="text-sm text-muted">@Localizer["Ao trocar a senha, as outras sessões abertas em outros aparelhos são encerradas."]</p>

            <div class="flex flex-wrap gap-3">
                <button type="submit" class="btn btn-primary">@Localizer["Trocar a senha"]</button>
                <a asp-action="Delete" class="btn btn-link">@Localizer["Voltar para Minha conta"]</a>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
