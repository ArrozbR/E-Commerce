@model LoginViewModel
@{
    ViewData["Title"] = Localizer["Entrar"].Value;
}

<h1>@Localizer["Entrar"]</h1>

<div>
    <div class="max-w-md">
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Email" class="label"></label>
                <input asp-for="Email" class="input" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="label"></label>
                <input asp-for="Password" class="input" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">@Localizer["Entrar"]</button>
        </form>
    </div>
</div>

<div class="mt-4">
    <div class="max-w-md">
        <form asp-action="ExternalLogin" method="post">
            <button type="submit" class="btn btn-secondary w-full">@Localizer["Entrar com o Google"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}