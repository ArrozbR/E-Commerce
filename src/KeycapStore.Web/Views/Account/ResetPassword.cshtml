@model ResetPasswordViewModel
@{
    ViewData["Title"] = Localizer["Escolher a senha nova"].Value;
}

<h1>@Localizer["Escolher a senha nova"]</h1>

<div class="card max-w-xl">
    <form asp-action="ResetPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />

        <div class="mb-4">
            <label asp-for="NewPassword" class="label"></label>
            <input asp-for="NewPassword" class="input" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <div class="mb-4">
            <label asp-for="ConfirmNewPassword" class="label"></label>
            <input asp-for="ConfirmNewPassword" class="input" autocomplete="new-password" />
            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
        </div>

        <p class="text-sm text-muted">@Localizer["Ao trocar a senha, as sessões abertas em outros aparelhos são encerradas. Depois, entre com a senha nova."]</p>

        <button type="submit" class="btn btn-primary">@Localizer["Trocar a senha"]</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
