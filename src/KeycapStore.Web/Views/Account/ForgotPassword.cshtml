@model ForgotPasswordViewModel
@{
    ViewData["Title"] = Localizer["Esqueci minha senha"].Value;
}

<h1>@Localizer["Esqueci minha senha"]</h1>

<div class="card max-w-xl">
    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-success" role="status" data-forgot-sent>@message</div>
        <a asp-action="Login" class="btn btn-secondary">@Localizer["Voltar para Entrar"]</a>
    }
    else
    {
        <p>@Localizer["Digite o e-mail da sua conta. Se ela existir, enviamos um link para você escolher uma senha nova."]</p>

        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

            <div class="mb-4">
                <label asp-for="Email" class="label"></label>
                <input asp-for="Email" class="input" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="flex flex-wrap gap-3">
                <button type="submit" class="btn btn-primary">@Localizer["Enviar o link"]</button>
                <a asp-action="Login" class="btn btn-link">@Localizer["Voltar para Entrar"]</a>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
