@using KeycapStore.Domain.Orders
@using KeycapStore.Web.Models
@model IReadOnlyList<KeycapStore.Application.Orders.OrderSummaryView>
@{
    ViewData["Title"] = Localizer["Meus pedidos"].Value;
}

<h1 class="mb-6">@Localizer["Meus pedidos"]</h1>

@if (Model.Count == 0)
{
    <div class="card stage mx-auto flex max-w-xl flex-col items-center gap-4 py-12 text-center">
        <span class="step-key size-14 text-2xl" aria-hidden="true">0</span>
        <p class="mb-0 text-lg">@Localizer["Você ainda não fez nenhum pedido."]</p>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">@Localizer["Ver o catálogo"]</a>
    </div>
}
else
{
    <ul class="m-0 flex list-none flex-col gap-4 p-0">
        @foreach (var order in Model)
        {
            <li class="card flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between" data-reveal>
                <div class="min-w-0">
                    <div class="mb-1 flex flex-wrap items-center gap-3">
                        <h2 class="m-0 text-lg">@Localizer["Pedido {0}", order.Id.ToString()[..8]]</h2>
                        <span class="@OrderStatusText.BadgeClass(order.Status)">@SharedLocalizer[OrderStatusText.For(order.Status)]</span>
                    </div>
                    <p class="mb-1 text-sm text-muted">@Display.DateAndTime(order.CreatedAt)</p>
                    <p class="mb-0 truncate text-sm">@string.Join(", ", order.Lines.Select(l => $"{l.ProductName} × {l.Quantity}"))</p>
                </div>
                <div class="flex shrink-0 flex-wrap items-center justify-between gap-3 sm:flex-col sm:items-end">
                    <span class="font-display text-xl font-semibold">@Display.Price(order.Total)</span>
                    <div class="flex flex-wrap gap-2">
                        @if (order.Status is OrderStatus.AwaitingPayment)
                        {
                            <a asp-controller="Checkout" asp-action="Pay" asp-route-id="@order.Id" class="btn btn-primary btn-sm">@Localizer["Continuar o pagamento"]</a>
                        }
                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-secondary btn-sm">@Localizer["Ver o pedido"]</a>
                    </div>
                </div>
            </li>
        }
    </ul>
}
