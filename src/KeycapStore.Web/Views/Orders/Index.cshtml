@using KeycapStore.Web.Models
@model IReadOnlyList<KeycapStore.Application.Orders.OrderSummaryView>
@{
    ViewData["Title"] = "Meus pedidos";
}

<h1>Meus pedidos</h1>

@if (Model.Count == 0)
{
    <p>Você ainda não fez nenhum pedido. <a asp-controller="Catalog" asp-action="Index">Ver o catálogo</a></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Data</th>
                <th>Situação</th>
                <th class="text-end">Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@Display.DateAndTime(order.CreatedAt)</td>
                    <td>@OrderStatusText.For(order.Status)</td>
                    <td class="text-end">@Display.Price(order.Total)</td>
                    <td class="text-end"><a asp-action="Details" asp-route-id="@order.Id">Ver o pedido</a></td>
                </tr>
            }
        </tbody>
    </table>
}
