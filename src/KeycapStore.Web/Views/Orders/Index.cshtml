@using KeycapStore.Web.Models
@model IReadOnlyList<KeycapStore.Application.Orders.OrderSummaryView>
@{
    ViewData["Title"] = Localizer["Meus pedidos"].Value;
}

<h1>@Localizer["Meus pedidos"]</h1>

@if (Model.Count == 0)
{
    <p>@Localizer["Você ainda não fez nenhum pedido."] <a asp-controller="Catalog" asp-action="Index">@Localizer["Ver o catálogo"]</a></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@Localizer["Data"]</th>
                <th>@Localizer["Situação"]</th>
                <th class="text-end">@Localizer["Total"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@Display.DateAndTime(order.CreatedAt)</td>
                    <td>@SharedLocalizer[OrderStatusText.For(order.Status)]</td>
                    <td class="text-end">@Display.Price(order.Total)</td>
                    <td class="text-end"><a asp-action="Details" asp-route-id="@order.Id">@Localizer["Ver o pedido"]</a></td>
                </tr>
            }
        </tbody>
    </table>
}
