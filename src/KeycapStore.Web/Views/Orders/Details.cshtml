@using KeycapStore.Domain.Orders
@model KeycapStore.Application.Orders.OrderView
@{
    ViewData["Title"] = "Pedido";
    var brl = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    var brasilia = TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo");
    var status = Model.Status switch
    {
        OrderStatus.AwaitingPayment => "Aguardando pagamento",
        OrderStatus.AwaitingConfirmation => "Aguardando confirmação do pagamento",
        OrderStatus.Paid => "Pago",
        OrderStatus.Expired => "Expirado",
        OrderStatus.Failed => "Pagamento não aprovado",
        OrderStatus.PaidOutOfStock => "Pago, mas sem estoque",
        OrderStatus.Refunded => "Reembolsado",
        OrderStatus.Picking => "Em separação",
        OrderStatus.Shipped => "Enviado",
        OrderStatus.Delivered => "Entregue",
        _ => Model.Status.ToString(),
    };
    var address = Model.ShippingAddress;
}

<h1 class="mb-1">Pedido criado</h1>
<p class="text-muted">
    Número: @Model.Id<br />
    Feito em @TimeZoneInfo.ConvertTime(Model.CreatedAt, brasilia).ToString("dd/MM/yyyy HH:mm", brl)<br />
    Situação: <strong>@status</strong>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Produto</th>
            <th class="text-end">Preço</th>
            <th class="text-end">Quantidade</th>
            <th class="text-end">Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var line in Model.Lines)
        {
            <tr>
                <td>@line.ProductName</td>
                <td class="text-end">@line.UnitPrice.ToString("C", brl)</td>
                <td class="text-end">@line.Quantity</td>
                <td class="text-end">@line.LineTotal.ToString("C", brl)</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3" class="text-end">Frete</td>
            <td class="text-end">@(Model.ShippingFee == 0 ? "Grátis" : Model.ShippingFee.ToString("C", brl))</td>
        </tr>
        <tr>
            <th colspan="3" class="text-end">Total</th>
            <th class="text-end">@Model.Total.ToString("C", brl)</th>
        </tr>
    </tfoot>
</table>

<h2 class="h5">Entrega</h2>
<p>
    @address.RecipientName<br />
    @address.Street, @address.Number@(address.Complement is null ? "" : $" - {address.Complement}")<br />
    @address.District, @address.City - @address.State<br />
    CEP @address.PostalCode.Insert(5, "-")
</p>