@using KeycapStore.Web.Models
@model KeycapStore.Application.Orders.OrderView
@{
    ViewData["Title"] = "Pedido";
    var status = OrderStatusText.For(Model.Status);
    var address = Model.ShippingAddress;
}

<h1 class="mb-1">Pedido criado</h1>
<p class="text-muted">
    Número: @Model.Id<br />
    Feito em @Display.DateAndTime(Model.CreatedAt)<br />
    Situação: <strong>@status</strong>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Produto</th>
            <th class="text-end">Preço</th>
            <th class="text-end">Quantidade</th>
            <th class="text-end">Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var line in Model.Lines)
        {
            <tr>
                <td>@line.ProductName</td>
                <td class="text-end">@Display.Price(line.UnitPrice)</td>
                <td class="text-end">@line.Quantity</td>
                <td class="text-end">@Display.Price(line.LineTotal)</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3" class="text-end">Frete</td>
            <td class="text-end">@(Model.ShippingFee == 0 ? "Grátis" : Display.Price(Model.ShippingFee))</td>
        </tr>
        <tr>
            <th colspan="3" class="text-end">Total</th>
            <th class="text-end">@Display.Price(Model.Total)</th>
        </tr>
    </tfoot>
</table>

<h2 class="h5">Entrega</h2>
<p>
    @address.RecipientName<br />
    @address.Street, @address.Number@(address.Complement is null ? "" : $" - {address.Complement}")<br />
    @address.District, @address.City - @address.State<br />
    CEP @address.PostalCode.Insert(5, "-")
</p>

@if (Model.Status is KeycapStore.Domain.Orders.OrderStatus.Paid or KeycapStore.Domain.Orders.OrderStatus.Picking)
{
    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Cancelar este pedido? O valor pago será devolvido.');">
        <button type="submit" class="btn btn-outline-danger">Cancelar pedido</button>
    </form>
    <p class="text-muted small mt-1">Você pode cancelar até o pedido ser enviado. O valor é devolvido automaticamente.</p>
}

@if (Model.CanWithdraw)
{
    <form asp-action="Withdraw" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Desistir da compra? O valor pago será devolvido e você precisará devolver o produto.');">
        <button type="submit" class="btn btn-outline-danger">Desistir da compra</button>
    </form>
    <p class="text-muted small mt-1">
        Direito de arrependimento (CDC, art. 49):
        @(Model.WithdrawalDeadline is { } deadline
            ? $"você pode desistir até {Display.DateAndTime(deadline)}."
            : "você pode desistir até 7 dias depois de receber o pedido.")
        O valor é devolvido automaticamente em alguns minutos; depois, devolva o produto à loja.
    </p>
}
