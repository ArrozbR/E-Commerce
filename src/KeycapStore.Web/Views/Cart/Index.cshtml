@model KeycapStore.Application.Carts.CartView
@{
    ViewData["Title"] = Localizer["Carrinho"].Value;
}

<h1 class="mb-4">@Localizer["Carrinho"]</h1>

@if (Model.Lines.Count == 0)
{
    <p>@Localizer["Seu carrinho está vazio."] <a asp-controller="Catalog" asp-action="Index">@Localizer["Ver o catálogo"]</a></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@Localizer["Produto"]</th>
                <th class="text-end">@Localizer["Preço"]</th>
                <th class="text-end">@Localizer["Quantidade"]</th>
                <th class="text-end">@Localizer["Subtotal"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>
                        @line.ProductName
                        @if (!line.IsAvailable)
                        {
                            <br /><span class="badge bg-secondary">@Localizer["Indisponível"]</span>
                        }
                    </td>
                    <td class="text-end">@Display.Price(line.UnitPrice)</td>
                    <td class="text-end">
                        <form asp-action="ChangeQuantity" method="post" class="d-inline-flex gap-2">
                            <input type="hidden" name="productId" value="@line.ProductId" />
                            <input type="number" name="quantity" value="@line.Quantity" min="1" class="form-control form-control-sm" style="width: 5rem" />
                            <button type="submit" class="btn btn-outline-secondary btn-sm">@Localizer["Atualizar"]</button>
                        </form>
                    </td>
                    <td class="text-end">@Display.Price(line.LineTotal)</td>
                    <td class="text-end">
                        <form asp-action="Remove" method="post">
                            <input type="hidden" name="productId" value="@line.ProductId" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">@Localizer["Remover"]</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">@Localizer["Total"]</th>
                <th class="text-end">@Display.Price(Model.Total)</th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    @if (Model.HasUnavailableItems)
    {
        <p class="text-danger text-end">@Localizer["Um item do carrinho não está mais à venda. Remova-o para finalizar a compra."]</p>
    }

    <div class="text-end">
        <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary">@Localizer["Finalizar compra"]</a>
    </div>
}
