@model KeycapStore.Application.Carts.CartView
@{
    ViewData["Title"] = "Carrinho";
    var brl = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
}

<h1 class="mb-4">Carrinho</h1>

@if (Model.Lines.Count == 0)
{
    <p>Seu carrinho está vazio. <a asp-controller="Catalog" asp-action="Index">Ver o catálogo</a></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Produto</th>
                <th class="text-end">Preço</th>
                <th class="text-end">Quantidade</th>
                <th class="text-end">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.ProductName</td>
                    <td class="text-end">@line.UnitPrice.ToString("C", brl)</td>
                    <td class="text-end">@line.Quantity</td>
                    <td class="text-end">@line.LineTotal.ToString("C", brl)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Total</th>
                <th class="text-end">@Model.Total.ToString("C", brl)</th>
            </tr>
        </tfoot>
    </table>
}