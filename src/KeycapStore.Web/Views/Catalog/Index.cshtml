@model IReadOnlyList<KeycapStore.Application.Catalog.ProductSummary>
@{
    ViewData["Title"] = Localizer["Catálogo"].Value;
}

<h1>@Localizer["Catálogo"]</h1>

<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    @foreach (var product in Model)
    {
        <partial name="_KitCard" model="new KitCard(product)" />
    }
</div>
