@model IReadOnlyList<KeycapStore.Application.Catalog.ProductSummary>
@{
    ViewData["Title"] = Localizer["Catálogo"].Value;
}

<h1 class="mb-4">@Localizer["Catálogo"]</h1>

<div class="row">
    @foreach (var product in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text fs-4">@Display.Price(product.Price)</p>

                    @if (product.Stock == 0)
                    {
                        <span class="badge bg-secondary">@Localizer["Esgotado"]</span>
                    }
                    else if (product.Stock == 1)
                    {
                        <span class="badge bg-warning text-dark">@Localizer["Última unidade"]</span>
                    }
                    else if (product.Stock <= 3)
                    {
                        <span class="badge bg-warning text-dark">@Localizer["Últimas {0} unidades", product.Stock]</span>
                    }
                    else
                    {
                        <span class="badge bg-success">@Localizer["Em estoque"]</span>
                    }

                    @if (product.Stock > 0)
                    {
                        <form asp-controller="Cart" asp-action="Add" method="post" class="mt-3">
                            <input type="hidden" name="productId" value="@product.Id" />
                            <button type="submit" class="btn btn-primary btn-sm">@Localizer["Adicionar ao carrinho"]</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>
