@model PaymentPageViewModel
@{
    ViewData["Title"] = Localizer["Pagamento"].Value;
    var order = Model.Order;
    var address = order.ShippingAddress;
    var stripeLocale = Model.Form.Language == SiteCultures.English ? "en" : "pt-BR";
    var reservedUntil = order.CreatedAt.AddMinutes(30);
}

<partial name="_CheckoutSteps" model="4" />

<h1 class="mb-6">@Localizer["Pagamento"]</h1>

<div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <section class="card" aria-labelledby="payment-title">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
            <h2 id="payment-title" class="m-0">@Localizer["Como você quer pagar?"]</h2>
            <span class="countdown" data-countdown data-expires="@reservedUntil.ToString("O", System.Globalization.CultureInfo.InvariantCulture)" data-expired-text="@Localizer["Tempo esgotado"]">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8" /><path d="M12 9v4l2 2M9 2h6" /></svg>
                <span>@Localizer["Reservado por"] <span data-countdown-time>30:00</span></span>
            </span>
        </div>
        <p class="text-sm text-muted">@Localizer["O pedido fica reservado por 30 minutos. Depois disso, o estoque volta à loja e o pagamento não é mais aceito."]</p>

        <div id="payment" data-publishable-key="@Model.Form.PublishableKey" data-client-secret="@Model.Form.ClientSecret" data-locale="@stripeLocale" data-load-error="@Localizer["Não foi possível carregar o formulário de pagamento. Recarregue a página para tentar de novo."]">
            <div id="payment-element" class="mb-5 min-h-40"></div>
            <button id="pay-button" type="button" class="btn btn-primary w-full py-3 text-base" disabled>
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                <span>@Localizer["Pagar {0}", Display.Price(order.Total)]</span>
            </button>
            <div id="payment-message" class="mt-3 text-sm text-danger" role="alert"></div>
        </div>
        <noscript><p class="text-danger">@Localizer["O formulário de pagamento precisa de JavaScript."]</p></noscript>
        <p class="mt-4 mb-0 text-xs text-muted">@Localizer["O pagamento é processado pela Stripe. Os dados do cartão não passam pela loja."]</p>
    </section>

    <aside class="card summary lg:sticky lg:top-24" aria-labelledby="summary-title">
        <h2 id="summary-title" class="mt-0">@Localizer["Resumo do pedido"]</h2>
        <ul class="summary-items">
            @foreach (var line in order.Lines)
            {
                <li>
                    <span class="min-w-0">@line.ProductName <span class="text-muted">&times; @line.Quantity</span></span>
                    <span class="shrink-0">@Display.Price(line.LineTotal)</span>
                </li>
            }
        </ul>
        <dl class="summary-list">
            <div>
                <dt>@Localizer["Frete"]</dt>
                <dd>@(order.ShippingFee == 0 ? Localizer["Grátis"].Value : Display.Price(order.ShippingFee))</dd>
            </div>
        </dl>
        <div class="summary-total">
            <span>@Localizer["Total"]</span>
            <span>@Display.Price(order.Total)</span>
        </div>

        <h3 class="mt-6 text-base">@Localizer["Entrega"]</h3>
        <p class="mb-0 text-sm text-muted">
            @address.RecipientName<br />
            @address.Street, @address.Number@(address.Complement is null ? "" : $" - {address.Complement}")<br />
            @address.District, @address.City - @address.State<br />
            @Localizer["CEP {0}", address.PostalCode.Insert(5, "-")]
        </p>
        @if (order.ShippingService is not null)
        {
            <p class="mt-2 mb-0 text-sm text-muted">@order.ShippingService, @(order.ShippingDeliveryDays == 1 ? SharedLocalizer["até 1 dia"] : SharedLocalizer["até {0} dias", order.ShippingDeliveryDays!])</p>
        }
    </aside>
</div>

@section Scripts {
    <script src="https://js.stripe.com/endive/stripe.js"></script>
    <script src="~/js/pay.js" asp-append-version="true"></script>
}
