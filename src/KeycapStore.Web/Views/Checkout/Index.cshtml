@model CheckoutViewModel
@{
    ViewData["Title"] = "Endereço de entrega";
}

<h1>Endereço de entrega</h1>
<p class="text-muted">Frete grátis para DF, GO, MT, MS, SP e RJ. Para os demais estados, R$ 15,00.</p>
@if (ViewData["FromSavedAddress"] is true)
{
    <p class="alert alert-info">Preenchido com o endereço salvo na sua conta. Confira antes de finalizar.</p>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="Index" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <partial name="_AddressFields" model="Model" />

            <div class="form-check mb-3">
                <input asp-for="SaveAddress" class="form-check-input" />
                <label asp-for="SaveAddress" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">Finalizar pedido</button>
            <a asp-controller="Cart" asp-action="Index" class="btn btn-link">Voltar ao carrinho</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}