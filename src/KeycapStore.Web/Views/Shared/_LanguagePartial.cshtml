@using KeycapStore.Web.Localization
@{
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var current = System.Globalization.CultureInfo.CurrentUICulture.Name;
}

<form asp-controller="Language" asp-action="Set" method="post" class="flex items-center">
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    <button type="submit" name="culture" value="@SiteCultures.Portuguese" title="Português" lang="pt-BR"
            class="@(current == SiteCultures.Portuguese ? "font-bold text-fg" : "text-muted") cursor-pointer rounded-md px-2 py-1 text-sm hover:bg-surface">PT</button>
    <button type="submit" name="culture" value="@SiteCultures.English" title="English" lang="en"
            class="@(current == SiteCultures.English ? "font-bold text-fg" : "text-muted") cursor-pointer rounded-md px-2 py-1 text-sm hover:bg-surface">EN</button>
</form>
