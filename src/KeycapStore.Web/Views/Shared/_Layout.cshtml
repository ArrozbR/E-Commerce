<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KeycapStore</title>
    <link rel="icon" href="~/favicon.ico" sizes="16x16 32x32 48x48" asp-append-version="true" />
    <link rel="icon" href="~/icon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="preload" href="~/fonts/dm-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="flex min-h-screen flex-col">
    <div class="bg-dots pointer-events-none fixed inset-x-0 top-0 -z-10 h-[36rem]" aria-hidden="true"></div>
    <header class="sticky top-0 z-40 border-b border-line/70 bg-bg/70 backdrop-blur-md">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="logo inline-flex items-center gap-2 font-display text-lg font-bold tracking-tight text-fg hover:no-underline">
                <span class="logo-cap" aria-hidden="true">K</span>
                <span>KeycapStore</span>
            </a>

            <input type="checkbox" id="menu-toggle" class="peer sr-only" />
            <label for="menu-toggle" class="ml-auto cursor-pointer rounded-md border border-line px-3 py-1.5 text-sm peer-focus-visible:ring-2 peer-focus-visible:ring-brand md:hidden">@Localizer["Menu"]</label>

            <nav class="hidden w-full flex-col gap-1 text-sm peer-checked:flex md:flex md:w-auto md:grow md:flex-row md:items-center md:gap-5">
                <a class="py-1 text-fg" asp-area="" asp-controller="Catalog" asp-action="Index">@Localizer["Catálogo"]</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @await Component.InvokeAsync("CartCount")
                    <a class="py-1 text-fg" asp-area="" asp-controller="Orders" asp-action="Index">@Localizer["Meus pedidos"]</a>
                    @if (User.IsInRole(KeycapStore.Application.Identity.Roles.Admin))
                    {
                        <a class="py-1 text-fg" href="/admin/orders">@Localizer["Envio"]</a>
                        <a class="py-1 text-fg" href="/admin/products">@Localizer["Produtos"]</a>
                    }
                    <span class="py-1 text-muted md:ml-auto">@Localizer["Olá, {0}", User.Identity.Name!]</span>
                    <a class="py-1 text-fg" asp-area="" asp-controller="Account" asp-action="Delete">@Localizer["Minha conta"]</a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="cursor-pointer py-1 text-fg hover:underline">@Localizer["Sair"]</button>
                    </form>
                }
                else
                {
                    <a class="py-1 text-fg md:ml-auto" asp-area="" asp-controller="Account" asp-action="Register">@Localizer["Criar conta"]</a>
                    <a class="py-1 text-fg" asp-area="" asp-controller="Account" asp-action="Login">@Localizer["Entrar"]</a>
                }
                <div class="flex items-center gap-1">
                    <partial name="_LanguagePartial" />
                    <button type="button" id="theme-toggle" data-mode="system"
                            data-label-system="@Localizer["Tema: automático"]" data-label-light="@Localizer["Tema: claro"]" data-label-dark="@Localizer["Tema: escuro"]"
                            aria-label="@Localizer["Tema: automático"]" title="@Localizer["Tema: automático"]"
                            class="group cursor-pointer rounded-md p-2 text-fg hover:bg-surface">
                        <svg class="hidden size-4 group-data-[mode=system]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
                        <svg class="hidden size-4 group-data-[mode=light]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
                        <svg class="hidden size-4 group-data-[mode=dark]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
                    </button>
                </div>
            </nav>
        </div>
    </header>

    <main role="main" class="mx-auto w-full max-w-6xl grow px-4 py-8">
        @RenderBody()
    </main>

    <div id="toast-region" class="toast-region" role="status" aria-live="polite" data-added="@Localizer["Kit adicionado ao carrinho."]" data-failed="@Localizer["Não foi possível adicionar o kit. Tente de novo."]">
        @if (TempData[KeycapStore.Web.Controllers.CartController.CartAddedKey] is not null)
        {
            <partial name="_Toast" model="@Localizer["Kit adicionado ao carrinho."].Value" />
        }
    </div>
    <template id="toast-template">
        <partial name="_Toast" model="string.Empty" />
    </template>

    <footer class="border-t border-line">
        <div class="mx-auto max-w-6xl px-4 py-6 text-sm text-muted">
            &copy; 2026 KeycapStore · <a asp-area="" asp-controller="Home" asp-action="Privacy">@Localizer["Privacidade"]</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/gsap/gsap.min.js" asp-append-version="true" defer></script>
    <script src="~/lib/gsap/ScrollTrigger.min.js" asp-append-version="true" defer></script>
    <script src="~/js/motion.js" asp-append-version="true" defer></script>
    <script src="~/js/cart.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
