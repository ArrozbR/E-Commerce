@model KitIllustration
@{
    var palette = Model.Palette;

    (string Legend, int X, int Width, bool Accent, bool Big)[] keys =
    [
        ("Esc", 8, 84, true, false),
        (Model.Initial, 104, 84, false, true),
        ("Enter", 200, 112, true, false),
    ];
}

<svg viewBox="0 0 320 100" class="block h-auto w-full" aria-hidden="true" focusable="false">
    @foreach (var key in keys)
    {
        var fill = key.Accent ? palette.Accent : palette.Keys;
        var legend = key.Accent ? Model.AccentLegend : palette.Legends;
        <g>
            <rect x="@key.X" y="8" width="@key.Width" height="84" rx="12" fill="@fill" stroke="#000000" stroke-opacity="0.15" />
            <rect x="@key.X" y="68" width="@key.Width" height="24" rx="12" fill="#000000" fill-opacity="0.18" />
            <rect x="@(key.X + 7)" y="13" width="@(key.Width - 14)" height="60" rx="9" fill="#ffffff" fill-opacity="0.14" />
            @if (key.Big)
            {
                <g><text x="@(key.X + (key.Width / 2))" y="54" text-anchor="middle" font-size="34" font-weight="600" font-family="'Space Grotesk', sans-serif" fill="@legend">@key.Legend</text></g>
            }
            else
            {
                <g><text x="@(key.X + 16)" y="34" font-size="13" font-weight="500" font-family="'DM Sans', sans-serif" fill="@legend">@key.Legend</text></g>
            }
        </g>
    }
</svg>
