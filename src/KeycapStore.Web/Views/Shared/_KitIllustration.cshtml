@model KitIllustration
@{
    static string N(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    var unit = Model.Unit;
    var radius = unit * 0.16;
    var inset = unit * 0.12;
    var fontSize = unit >= 40 ? 11 : 8;
}

<svg viewBox="0 0 @N(Model.ViewWidth) @N(Model.ViewHeight)" class="block h-auto w-full" aria-hidden="true" focusable="false">
    <rect width="@N(Model.ViewWidth)" height="@N(Model.ViewHeight)" rx="14" style="fill: var(--surface); stroke: var(--line)" />
    @foreach (var key in Model.Keys)
    {
        var cap = Model.CapColor(key.Role);
        var legend = Model.LegendColor(key.Role);
        var iconScale = (unit * 0.46) / 24;
        var iconX = key.X + (key.Width / 2) - (12 * iconScale);
        var iconY = key.Y + (key.Height * 0.42) - (12 * iconScale);
        <g class="keycap" data-key="@key.KeyName" data-role="@key.Role" style="--d: @N(key.X / Model.ViewWidth); --press: @N(key.Height * 0.1)px">
            <rect class="keycap-cap" x="@N(key.X)" y="@N(key.Y)" width="@N(key.Width)" height="@N(key.Height)" rx="@N(radius)" fill="@cap" stroke="#000000" stroke-opacity="0.15" />
            <rect x="@N(key.X)" y="@N(key.Y + (key.Height * 0.72))" width="@N(key.Width)" height="@N(key.Height * 0.28)" rx="@N(radius)" fill="#000000" fill-opacity="0.22" />
            <rect class="keycap-glow" x="@N(key.X)" y="@N(key.Y)" width="@N(key.Width)" height="@N(key.Height)" rx="@N(radius)" />
            <g class="keycap-top">
                <rect class="keycap-cap" x="@N(key.X)" y="@N(key.Y)" width="@N(key.Width)" height="@N(key.Height * 0.72)" rx="@N(radius)" fill="@cap" />
                <rect x="@N(key.X + inset)" y="@N(key.Y + (inset * 0.6))" width="@N(key.Width - (inset * 2))" height="@N(key.Height * 0.7)" rx="@N(radius * 0.75)" fill="#ffffff" fill-opacity="0.12" />
                @if (key.Icon != KeyIcon.None)
                {
                    <g class="keycap-legend" transform="translate(@N(iconX) @N(iconY)) scale(@N(iconScale))" fill="@legend" stroke="@legend" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        @switch (key.Icon)
                        {
                            case KeyIcon.Star:
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26" />
                                break;
                            case KeyIcon.Heart:
                                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                                break;
                            case KeyIcon.Moon:
                                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
                                break;
                            case KeyIcon.Bolt:
                                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                                break;
                            case KeyIcon.Wave:
                                <path d="M2 9c2-3 4-3 6 0s4 3 6 0 4-3 6 0M2 16c2-3 4-3 6 0s4 3 6 0 4-3 6 0" fill="none" />
                                break;
                            case KeyIcon.Sun:
                                <circle cx="12" cy="12" r="4" />
                                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" fill="none" />
                                break;
                            case KeyIcon.Return:
                                <path d="M20 4v7a4 4 0 0 1-4 4H4M9 10l-5 5 5 5" fill="none" />
                                break;
                        }
                    </g>
                }
                else if (key.Legend.Length > 0)
                {
                    <g><text class="keycap-legend" x="@N(key.X + (inset * 1.3))" y="@N(key.Y + (unit * 0.4))" font-size="@fontSize" font-weight="500" font-family="'DM Sans', sans-serif" fill="@legend">@key.Legend</text></g>
                }
            </g>
            <rect class="keycap-outline" x="@N(key.X)" y="@N(key.Y)" width="@N(key.Width)" height="@N(key.Height)" rx="@N(radius)" />
        </g>
    }
</svg>
